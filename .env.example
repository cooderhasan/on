# Hassas ayarları (NES API anahtarı) veritabanında şifrelemek için 32 byte base64 anahtar.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production'da zorunlu; sonradan DEĞİŞTİRMEYİN (şifreli ayarlar okunamaz olur).
ENCRYPTION_KEY=""

# Zamanlanmış görev anahtarı (en az 16 karakter). Coolify'da Scheduled Task /api/zamanlayici'yi bu anahtarla çağırır.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Boş bırakılırsa zamanlayıcı ucu kapalıdır (e-belge durumu ve gelen faturalar elle yenilenir).
CRON_SECRET=""

# İlk kurulum anahtarı (canlıda zorunlu, en az 12 karakter): /kurulum ekranı bunu ister. Geliştirmede boş bırakılabilir.
SETUP_TOKEN=""
