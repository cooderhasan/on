// Ön muhasebe — tek firma. Para tutarları Decimal(18,2) / kur Decimal(18,6); asla Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Firma (tek satır: id = "firma") ─────────────────────────

/// Faturada satıcı bilgisi olarak kullanılır. Tek firma uygulaması → her zaman tek kayıt.
model Company {
  id         String   @id @default("firma")
  /// Ticari unvan (faturada görünen)
  title      String
  /// 10 hane VKN veya 11 hane TCKN (şahıs şirketi)
  taxNumber  String?
  taxOffice  String?
  address    String?
  district   String?
  city       String?
  postalCode String?
  phone      String?
  email      String?
  website    String?
  sector     String?
  /// Mersis / ticaret sicil (faturada opsiyonel)
  mersisNo   String?
  tradeRegNo String?
  logoPath   String?
  updatedAt  DateTime @updatedAt
}

// ── Kullanıcılar ve oturum ─────────────────────────────────

/// ADMIN: her şey + kullanıcı/ayar · ACCOUNTANT: tüm muhasebe kayıtları · SALES: satış/müşteri/teklif · VIEWER: sadece görüntüleme
enum UserRole {
  ADMIN
  ACCOUNTANT
  SALES
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// scrypt: "salt:hash" (hex)
  passwordHash String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
}

/// Sunucu tarafı oturum: çerezde yalnızca rastgele token durur, veritabanında SHA-256 özeti.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Kritik işlemlerin kaydı (fatura resmileştirme, silme, ayar değişikliği, giriş…)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ── Kategori ve etiketler ──────────────────────────────────

/// Paraşüt: gelir (satış), gider, müşteri/tedarikçi, ürün ve çalışan kategorileri ayrı listelenir.
enum CategoryType {
  SALES
  EXPENSE
  CONTACT
  PRODUCT
  EMPLOYEE
}

model Category {
  id        String       @id @default(cuid())
  type      CategoryType
  name      String
  /// #rrggbb (rozet rengi)
  color     String       @default("#9e9e9e")
  createdAt DateTime     @default(now())

  contacts  Contact[]
  products  Product[]
  invoices  Invoice[]
  expenses  Expense[]
  employees Employee[]

  @@unique([type, name])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  invoices InvoiceTag[]
}

// ── Cariler: müşteri ve tedarikçi ──────────────────────────

enum ContactKind {
  CUSTOMER
  SUPPLIER
}

/// Tüzel kişi (şahıs şirketleri dahil LTD, AŞ…) / gerçek kişi
enum PersonType {
  LEGAL
  NATURAL
}

/// Dövizli bakiyenin TL karşılığı hesaplanırken kullanılan kur
enum RateType {
  BUYING
  SELLING
}

/// Açılış bakiyesi yönü: müşteri bize borçlu (DEBIT) / biz ona borçluyuz (CREDIT)
enum BalanceSide {
  DEBIT
  CREDIT
}

model Contact {
  id                 String       @id @default(cuid())
  kind               ContactKind
  personType         PersonType   @default(LEGAL)
  /// Firma unvanı veya ad soyad
  title              String
  shortName          String?
  /// 10 hane VKN / 11 hane TCKN (doğrulanmış)
  taxNumber          String?
  taxOffice          String?
  categoryId         String?
  email              String?
  phone              String?
  fax                String?
  address            String?
  isAbroad           Boolean      @default(false)
  postalCode         String?
  district           String?
  city               String?
  country            String?
  currency           String       @default("TRY")
  rateType           RateType     @default(BUYING)
  openingBalance     Decimal?     @db.Decimal(18, 2)
  openingBalanceSide BalanceSide?
  openingBalanceDate DateTime?    @db.Date
  notes              String?
  /// NES mükellef sorgusu: e-Fatura posta kutusu (PK) etiketi; null = e-Fatura mükellefi değil / sorgulanmadı
  eInvoiceAlias      String?
  eInvoiceCheckedAt  DateTime?
  /// Müşteriye özel fiyat listesi (satış belgelerinde birim fiyat buradan gelir)
  priceListId        String?
  isArchived         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ibans           ContactIban[]
  people          ContactPerson[]
  invoices        Invoice[]
  quotes          Quote[]
  transactions    Transaction[]
  expenses        Expense[]
  waybills        Waybill[]
  cheques         Cheque[]        @relation("ChequeContact")
  endorsedCheques Cheque[]        @relation("ChequeEndorsed")
  priceList       PriceList?      @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  @@index([kind, isArchived])
  @@index([taxNumber])
  @@index([title])
}

model ContactIban {
  id        String  @id @default(cuid())
  contactId String
  iban      String
  bankName  String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

/// Yetkili kişiler (Paraşüt: ad, e-posta, telefon, not)
model ContactPerson {
  id        String  @id @default(cuid())
  contactId String
  name      String
  email     String?
  phone     String?
  notes     String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// ── Hizmet ve ürünler ──────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  name          String
  code          String?  @unique
  barcode       String?
  categoryId    String?
  /// GİB birim kodu (C62 = adet, KGM = kg …) — bkz. src/lib/units.ts
  unit          String   @default("C62")
  /// Gümrük tarife (ihracat faturası)
  gtipCode      String?
  trackStock    Boolean  @default(true)
  /// Güncel stok (stok hareketleriyle güncellenir; Faz 5). Başlangıç stoku buraya yazılır.
  stockQuantity Decimal  @default(0) @db.Decimal(18, 4)
  initialStock  Decimal  @default(0) @db.Decimal(18, 4)
  criticalStock Decimal? @db.Decimal(18, 4)
  /// Vergiler hariç fiyatlar
  buyPrice      Decimal? @db.Decimal(18, 6)
  buyCurrency   String   @default("TRY")
  sellPrice     Decimal? @db.Decimal(18, 6)
  sellCurrency  String   @default("TRY")
  /// KDV oranı (%): 0, 1, 10, 20
  vatRate       Int      @default(20)
  photoPath     String?
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lines          DocumentLine[]
  stockMovements StockMovement[]
  transferLines  StockTransferLine[]
  waybillLines   WaybillLine[]
  priceListItems PriceListItem[]

  @@index([isArchived])
  @@index([name])
  @@index([barcode])
}

// ── Kasa ve bankalar ───────────────────────────────────────

enum AccountType {
  CASH
  BANK
}

model Account {
  id             String      @id @default(cuid())
  type           AccountType
  name           String
  currency       String      @default("TRY")
  bankName       String?
  branch         String?
  accountNo      String?
  iban           String?
  /// Açılış bakiyesi (hareketler Faz 2+ ile eklenir)
  openingBalance Decimal     @default(0) @db.Decimal(18, 2)
  openingDate    DateTime?   @db.Date
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions Transaction[] @relation("TxAccount")
  transfersIn  Transaction[] @relation("TxTargetAccount")
  cheques      Cheque[]

  @@index([type, isArchived])
}

// ── Satış / alış belgeleri ─────────────────────────────────
// Tutarlar belge para biriminde; exchangeRate = 1 birim dövizin TL karşılığı (TRY belgede 1).

enum InvoiceDirection {
  SALE
  PURCHASE
}

enum InvoiceKind {
  /// Satış / alış faturası
  INVOICE
  /// İade faturası (cari bakiyeyi ters yönde etkiler)
  RETURN
}

/// Stok çıkışı/girişi fatura ile mi yapılsın (Paraşüt "stok takibi" seçeneği)
enum StockMode {
  WITH_INVOICE
  NONE
}

/// e-Belge durumu (Faz 3: NES)
enum EDocStatus {
  NONE
  QUEUED
  SENT
  ACCEPTED
  REJECTED
  FAILED
  CANCELLED
}

model Invoice {
  id               String           @id @default(cuid())
  direction        InvoiceDirection @default(SALE)
  kind             InvoiceKind      @default(INVOICE)
  /// Fatura ismi (Paraşüt: listede başlık; boşsa "Satış Faturası")
  name             String?
  /// Fatura no (elle veya e-belgede NES'ten dönen)
  invoiceNo        String?
  contactId        String
  issueDate        DateTime         @db.Date
  dueDate          DateTime         @db.Date
  currency         String           @default("TRY")
  exchangeRate     Decimal          @default(1) @db.Decimal(18, 6)
  categoryId       String?
  notes            String?
  orderNo          String?
  orderDate        DateTime?        @db.Date
  stockMode        StockMode        @default(WITH_INVOICE)
  /// Genel indirim (ara toplama): oran (%) veya tutar
  discountType     DiscountType?
  discountValue    Decimal?         @db.Decimal(18, 6)
  // Hesaplanan toplamlar (belge para birimi) — src/lib/invoice-calc.ts
  grossTotal       Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal          @default(0) @db.Decimal(18, 2)
  netTotal         Decimal          @default(0) @db.Decimal(18, 2)
  otvTotal         Decimal          @default(0) @db.Decimal(18, 2)
  vatTotal         Decimal          @default(0) @db.Decimal(18, 2)
  withholdingTotal Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal          @default(0) @db.Decimal(18, 2)
  /// Faturadan tahsil / ödeme edilecek (genel toplam − tevkifat)
  payableTotal     Decimal          @default(0) @db.Decimal(18, 2)
  /// e-Belge (Faz 3)
  eDocStatus       EDocStatus       @default(NONE)
  eDocProfile      String?
  eDocUuid         String?          @unique
  eDocError        String?
  eDocSentAt       DateTime?
  /// Ticari faturada alıcının yanıtı: Waiting / Accepted / Rejected
  eDocAnswer       String?
  eDocCheckedAt    DateTime?
  /// İade faturasında iade edilen faturanın no ve tarihi (UBL BillingReference)
  returnRefNo      String?
  returnRefDate    DateTime?        @db.Date
  /// Stok hareketinin yazıldığı depo (boş = varsayılan depo)
  warehouseId      String?
  /// Tekliften oluşturulduysa
  quoteId          String?          @unique
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lines        DocumentLine[]
  tags         InvoiceTag[]
  transactions Transaction[]
  quote        Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  stockMoves   StockMovement[]
  incoming     IncomingInvoice?
  warehouse    Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  waybills     Waybill[]
  cheques      Cheque[]

  @@index([direction, issueDate])
  @@index([contactId])
  @@index([dueDate])
}

model InvoiceTag {
  invoiceId String
  tagId     String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([invoiceId, tagId])
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum QuoteStatus {
  OPEN
  ACCEPTED
  REJECTED
  INVOICED
}

model Quote {
  id               String        @id @default(cuid())
  quoteNo          String?
  name             String?
  contactId        String
  issueDate        DateTime      @db.Date
  validUntil       DateTime?     @db.Date
  currency         String        @default("TRY")
  exchangeRate     Decimal       @default(1) @db.Decimal(18, 6)
  status           QuoteStatus   @default(OPEN)
  notes            String?
  discountType     DiscountType?
  discountValue    Decimal?      @db.Decimal(18, 6)
  grossTotal       Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(18, 2)
  netTotal         Decimal       @default(0) @db.Decimal(18, 2)
  otvTotal         Decimal       @default(0) @db.Decimal(18, 2)
  vatTotal         Decimal       @default(0) @db.Decimal(18, 2)
  withholdingTotal Decimal       @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal       @default(0) @db.Decimal(18, 2)
  payableTotal     Decimal       @default(0) @db.Decimal(18, 2)
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  lines   DocumentLine[]
  invoice Invoice?

  @@index([issueDate])
  @@index([contactId])
}

/// Fatura ve teklif satırı (tam olarak biri dolu)
model DocumentLine {
  id                String        @id @default(cuid())
  invoiceId         String?
  quoteId           String?
  position          Int
  productId         String?
  /// Hizmet / ürün adı (ürün kartı değişse de belgede kalır)
  name              String
  description       String?
  quantity          Decimal       @db.Decimal(18, 4)
  unit              String        @default("C62")
  unitPrice         Decimal       @db.Decimal(18, 6)
  discountType      DiscountType?
  discountValue     Decimal?      @db.Decimal(18, 6)
  vatRate           Int
  /// KDV %0 ise GİB istisna sebep kodu (201…351)
  vatExemptionCode  String?
  otvRate           Decimal?      @db.Decimal(9, 4)
  /// ÖTV vergi kodu (0071, 0073, 0074…)
  otvCode           String?
  /// Tevkifat: GİB kodu (601…) ve oran (örn. 5/10 → 50)
  withholdingCode   String?
  withholdingRate   Int?
  // Hesaplanan (belge para birimi)
  grossAmount       Decimal       @db.Decimal(18, 2)
  discountAmount    Decimal       @db.Decimal(18, 2)
  /// Satır indirimi + dağıtılan genel indirim sonrası matrah (ÖTV hariç)
  netAmount         Decimal       @db.Decimal(18, 2)
  otvAmount         Decimal       @db.Decimal(18, 2)
  vatAmount         Decimal       @db.Decimal(18, 2)
  withholdingAmount Decimal       @db.Decimal(18, 2)
  totalAmount       Decimal       @db.Decimal(18, 2)

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([quoteId])
  @@index([productId])
}

// ── Para hareketleri ───────────────────────────────────────

enum TransactionType {
  /// Müşteriden tahsilat (kasaya / bankaya giriş)
  COLLECTION
  /// Tedarikçiye / çalışana ödeme (çıkış) — Faz 4
  PAYMENT
  /// Hesaplar arası transfer (accountId → targetAccountId)
  TRANSFER
  /// Cari ile ilgisi olmayan giriş / çıkış (ör. ortak para koydu, banka masrafı)
  DEPOSIT
  WITHDRAWAL
}

model Transaction {
  id              String          @id @default(cuid())
  type            TransactionType
  date            DateTime        @db.Date
  /// Boş: çek ile tahsilat / ödeme / ciro (para henüz kasa / bankada değil)
  accountId       String?
  /// Transferde hedef hesap
  targetAccountId String?
  contactId       String?
  invoiceId       String?
  /// Fatura dışı gider (hızlı fiş, maaş, vergi, banka gideri) ödemesi
  expenseId       String?
  /// Çalışana yapılan ödeme (maaş / avans)
  employeeId      String?
  /// Çek hareketi (alındı, ciro, karşılıksız, tahsil, ödeme) — yalnızca çek ekranından yönetilir
  chequeId        String?
  /// Hesap para biriminde tutar (her zaman pozitif; yön türden gelir)
  amount          Decimal         @db.Decimal(18, 2)
  /// Faturaya / cariye yansıyan tutar (fatura para biriminde; aynı dövizde amount ile eşit)
  appliedAmount   Decimal         @db.Decimal(18, 2)
  /// Transferde hedef hesaba giren tutar (farklı dövizde farklı olabilir)
  targetAmount    Decimal?        @db.Decimal(18, 2)
  description     String?
  createdById     String?
  createdAt       DateTime        @default(now())

  account       Account?  @relation("TxAccount", fields: [accountId], references: [id], onDelete: Restrict)
  targetAccount Account?  @relation("TxTargetAccount", fields: [targetAccountId], references: [id], onDelete: Restrict)
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expense       Expense?  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cheque        Cheque?   @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([chequeId])
  @@index([expenseId])
  @@index([employeeId])
  @@index([contactId, date])
  @@index([invoiceId])
}

// ── Stok hareketleri ───────────────────────────────────────

enum StockMoveSource {
  /// Ürün kartındaki başlangıç stoku
  OPENING
  INVOICE
  WAYBILL
  TRANSFER
  /// Sayım / elle düzeltme
  ADJUSTMENT
}

model StockMovement {
  id          String          @id @default(cuid())
  productId   String
  warehouseId String
  /// + giriş, − çıkış
  quantity    Decimal         @db.Decimal(18, 4)
  date        DateTime        @db.Date
  source      StockMoveSource
  invoiceId   String?
  waybillId   String?
  transferId  String?
  note        String?
  createdById String?
  createdAt   DateTime        @default(now())

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  invoice   Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  waybill   Waybill?       @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  transfer  StockTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([productId, date])
  @@index([warehouseId])
  @@index([invoiceId])
  @@index([waybillId])
  @@index([transferId])
  @@index([date])
}

/// Depo. Tam olarak bir tanesi varsayılan (faturada depo seçilmezse kullanılır).
model Warehouse {
  id         String   @id @default(cuid())
  name       String   @unique
  address    String?
  isDefault  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockMoves   StockMovement[]
  invoices     Invoice[]
  waybills     Waybill[]
  transfersOut StockTransfer[] @relation("TransferFrom")
  transfersIn  StockTransfer[] @relation("TransferTo")
}

/// Depolar arası transfer (toplam stok değişmez)
model StockTransfer {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  fromWarehouseId String
  toWarehouseId   String
  description     String?
  createdById     String?
  createdAt       DateTime @default(now())

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  lines         StockTransferLine[]
  stockMoves    StockMovement[]

  @@index([date])
}

model StockTransferLine {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(18, 4)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
}

// ── İrsaliyeler (giden: SALE, gelen: PURCHASE) ─────────────
// Stok irsaliye ile hareket eder; irsaliyeden oluşturulan fatura stoğa dokunmaz.

model Waybill {
  id              String           @id @default(cuid())
  direction       InvoiceDirection
  waybillNo       String?
  contactId       String
  warehouseId     String
  issueDate       DateTime         @db.Date
  /// Sevk / teslim tarihi
  dispatchDate    DateTime         @db.Date
  deliveryAddress String?
  notes           String?
  /// Faturalandıysa
  invoiceId       String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contact    Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  invoice    Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lines      WaybillLine[]
  stockMoves StockMovement[]

  @@index([direction, issueDate])
  @@index([contactId])
  @@index([invoiceId])
}

model WaybillLine {
  id        String  @id @default(cuid())
  waybillId String
  position  Int
  productId String?
  name      String
  quantity  Decimal @db.Decimal(18, 4)
  unit      String  @default("C62")

  waybill Waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([waybillId])
}

// ── Fiyat listeleri ────────────────────────────────────────

model PriceList {
  id         String   @id @default(cuid())
  name       String   @unique
  /// Listedeki fiyatların para birimi (vergiler hariç)
  currency   String   @default("TRY")
  notes      String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items    PriceListItem[]
  contacts Contact[]
}

model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  productId   String
  price       Decimal @db.Decimal(18, 6)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
}

// ── Çekler ─────────────────────────────────────────────────

/// Alınan (müşteriden) / verilen (tedarikçiye, kendi çekimiz)
enum ChequeDirection {
  RECEIVED
  ISSUED
}

/// Alınan: PORTFOLIO → COLLECTED (bankaya tahsil) | ENDORSED (tedarikçiye ciro) | BOUNCED (karşılıksız)
/// Verilen: PENDING → PAID (hesaptan ödendi)
enum ChequeStatus {
  PORTFOLIO
  COLLECTED
  ENDORSED
  BOUNCED
  PENDING
  PAID
}

/// Çek alınınca / verilince cari bakiyesi hemen kapanır (hesapsız tahsilat / ödeme hareketi);
/// para kasa / bankaya tahsil veya ödeme günü girer / çıkar.
model Cheque {
  id           String          @id @default(cuid())
  direction    ChequeDirection
  status       ChequeStatus
  contactId    String
  /// Belirli bir faturanın tahsilatı / ödemesi ise
  invoiceId    String?
  chequeNo     String
  bankName     String?
  branch       String?
  /// Düzenleyen (keşideci) — alınan çekte müşteriden farklı olabilir
  drawer       String?
  amount       Decimal         @db.Decimal(18, 2)
  currency     String          @default("TRY")
  issueDate    DateTime        @db.Date
  dueDate      DateTime        @db.Date
  /// Son durum değişikliği tarihi (tahsil / ciro / ödeme / karşılıksız)
  statusDate   DateTime?       @db.Date
  /// Tahsil edildiği / ödendiği hesap
  accountId    String?
  /// Ciro edilen tedarikçi
  endorsedToId String?
  notes        String?
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  contact      Contact       @relation("ChequeContact", fields: [contactId], references: [id], onDelete: Restrict)
  endorsedTo   Contact?      @relation("ChequeEndorsed", fields: [endorsedToId], references: [id], onDelete: Restrict)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([direction, status, dueDate])
  @@index([contactId])
}

// ── e-Fatura / e-Arşiv (NES) ayarları — tek satır ──────────

model EInvoiceSettings {
  id             String   @id @default("nes")
  /// https://apitest.nes.com.tr/ (test) veya https://api.nes.com.tr/ (canlı)
  apiUrl         String   @default("https://apitest.nes.com.tr/")
  /// AES-256-GCM ile şifreli API anahtarı (ENCRYPTION_KEY)
  apiKeyEnc      String?
  apiKeyLast4    String?
  /// Gönderici birim (GB) etiketi, ör. urn:mail:defaultgb@nes.com.tr
  senderAlias    String?
  /// Portalda tanımlı 3 harfli seriler (NES numarayı verir)
  eInvoiceSeries String?
  eArchiveSeries String?
  /// e-Fatura mükellefine varsayılan senaryo
  defaultProfile String   @default("TICARIFATURA")
  updatedAt      DateTime @updatedAt
}

// ── Giderler (fatura dışı) ─────────────────────────────────

/// Paraşüt: hızlı fiş/fatura, maaş / prim, vergi / SGK primi, banka gideri
enum ExpenseKind {
  RECEIPT
  SALARY
  TAX
  BANK_FEE
}

model Expense {
  id          String      @id @default(cuid())
  kind        ExpenseKind
  description String
  date        DateTime    @db.Date
  dueDate     DateTime    @db.Date
  categoryId  String?
  /// Hızlı fiş: tedarikçi (isteğe bağlı)
  contactId   String?
  /// Maaş / prim: çalışan
  employeeId  String?
  currency    String      @default("TRY")
  /// KDV hariç tutar, KDV oranı ve tutarı (hızlı fişte); diğer türlerde KDV 0
  netAmount   Decimal     @db.Decimal(18, 2)
  vatRate     Int         @default(0)
  vatAmount   Decimal     @default(0) @db.Decimal(18, 2)
  totalAmount Decimal     @db.Decimal(18, 2)
  receiptNo   String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([date])
  @@index([kind])
}

model Employee {
  id         String    @id @default(cuid())
  name       String
  tckn       String?
  email      String?
  phone      String?
  iban       String?
  categoryId String?
  startDate  DateTime? @db.Date
  notes      String?
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenses     Expense[]
  transactions Transaction[]

  @@index([isArchived])
}

// ── Gelen e-Faturalar (NES) ────────────────────────────────

enum IncomingStatus {
  /// Henüz işlenmedi
  NEW
  /// Alış faturası olarak kaydedildi
  PROCESSED
  /// Kullanıcı yok saydı (ör. iade edildi, mükerrer)
  IGNORED
}

model IncomingInvoice {
  id                String         @id @default(cuid())
  uuid              String         @unique
  documentNumber    String?
  issueDate         DateTime       @db.Date
  senderTaxNumber   String?
  senderTitle       String
  profile           String?
  typeCode          String?
  currency          String         @default("TRY")
  taxExclusive      Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal        @default(0) @db.Decimal(18, 2)
  payableAmount     Decimal        @db.Decimal(18, 2)
  /// Ticari faturada bizim yanıtımız: None / Waiting / Accepted / Rejected
  answer            String?
  receivedAt        DateTime
  status            IncomingStatus @default(NEW)
  purchaseInvoiceId String?        @unique
  syncedAt          DateTime       @default(now())

  purchaseInvoice Invoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  @@index([issueDate])
  @@index([status])
}

// ── Yazdırma şablonu ayarları (tek satır: id = "yazdir") ───
/// Kağıt fatura / teklif / proforma çıktısının alt bölümü. e-Belgelerin resmi görüntüsü NES'ten gelir.
model PrintSettings {
  id                 String   @id @default("yazdir")
  /// Belge altına yazılacak not (ör. ödeme koşulları, teşekkür)
  footerNote         String?
  /// Altta IBAN'ı gösterilecek banka hesapları
  bankAccountIds     String[]
  /// "YALNIZ ... TL" satırı
  showAmountInWords  Boolean  @default(true)
  /// Teslim eden / teslim alan imza alanı
  showSignature      Boolean  @default(false)
  /// Faturada müşterinin güncel bakiyesi
  showContactBalance Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}
